<?xml version="1.0" encoding="UTF-8"?>
<!--
  Log4j2 configuration replacing end-of-life log4j 1.x.
  Log levels and file appenders are configured programmatically per-job in
  DBReaderDriver / Main, so the root logger uses ERROR here to suppress noise.
-->
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5p %c{1} - %m%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Root level="ERROR">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
